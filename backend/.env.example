# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dpdp_healthcare_dev

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Google OAuth 2.0 (Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# NEVER commit the real secret — keep it only in your local .env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Blockchain (Ganache)
GANACHE_URL=http://localhost:8545
GANACHE_CHAIN_ID=1337

# Blockchain network: "ganache" (local, default) or "sepolia" (public testnet).
# Sepolia makes anchored record hashes verifiable on a public block explorer.
BLOCKCHAIN_NETWORK=ganache
# Only needed when BLOCKCHAIN_NETWORK=sepolia:
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_PRIVATE_KEY=0xyour_funded_testnet_private_key
SEPOLIA_CHAIN_ID=11155111
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io/tx/

# Encryption
KEY_STORE_PATH=./keystore

# CORS
CORS_ORIGINS=http://localhost:5173
