# SIH contracts — Sepolia deployment (Week 4 / Phase 4).
# Copy to contracts/.env and fill in. NEVER commit the real .env (gitignored).
#
# Get a free Sepolia RPC URL from Infura or Alchemy.
# Use a THROWAWAY funded testnet wallet — its ETH has no real value, but keep
# the key private anyway.

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_PRIVATE_KEY=0xyour_funded_testnet_private_key

# Optional: override the local Ganache RPC (defaults to http://127.0.0.1:8545)
GANACHE_URL=http://127.0.0.1:8545
