# Backend API base URL (defaults to /api/v1 if unset)
VITE_API_URL=http://localhost:5000/api/v1

# Google OAuth 2.0 — the OAuth Client ID is public (safe to ship to the browser).
# The client SECRET must NEVER be placed here; it stays on the backend only.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
